{
  "compilerOptions": {
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["mocha", "chai"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2015"],
    "module": "commonjs",
    "target": "es6",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": ["tests", "programs", "migrations", "node_modules"]
}
